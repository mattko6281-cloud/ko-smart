# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# smart-label experiment outputs, caches, samples, and local reports (only allow pure engine src/*.mjs)
/experiments/*
!/experiments/smart-label-engine/
/experiments/smart-label-engine/*
!/experiments/smart-label-engine/src/
!/experiments/smart-label-prototype/
/experiments/smart-label-prototype/*
!/experiments/smart-label-prototype/src/
!/experiments/smart-label-prototype-v02/
/experiments/smart-label-prototype-v02/*
!/experiments/smart-label-prototype-v02/src/
!/experiments/smart-label-prototype-v021/
/experiments/smart-label-prototype-v021/*
!/experiments/smart-label-prototype-v021/src/
/KO_SMART_*.md
/.smart-label-beta-disabled
